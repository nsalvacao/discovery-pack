{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constraints & NFRs Schema",
  "type": "object",
  "required": ["project", "date"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "metadata": {"$ref": "common.schema.json#/definitions/metadata"},
    "security": {
      "type": "object",
      "properties": {
        "authentication": {"$ref": "common.schema.json#/definitions/tagged_statement"},
        "data_protection": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/tagged_statement"}},
        "trust_boundaries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "response_time_targets": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/metric"}},
        "throughput": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/metric"}}
      }
    },
    "availability": {
      "type": "object",
      "properties": {
        "sla_target": {"type": "string"},
        "rto": {"type": "string"},
        "rpo": {"type": "string"}
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "logging": {"type": "array", "items": {"$ref": "common.schema.json#/definitions/tagged_statement"}},
        "metrics": {"type": "array", "items": {"type": "string"}},
        "tracing": {"type": "boolean"}
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "platforms_supported": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
