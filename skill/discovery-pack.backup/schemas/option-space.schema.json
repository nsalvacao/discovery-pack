{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Option Space Analysis Schema",
  "type": "object",
  "required": ["project", "date", "decision_context", "options", "decision_criteria", "recommendation"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "decision_status": {
      "type": "string",
      "enum": ["pending", "decided"]
    },
    "metadata": {"$ref": "common.schema.json#/definitions/metadata"},

    "decision_context": {
      "type": "object",
      "required": ["what_deciding", "why_matters", "deadline"],
      "properties": {
        "what_deciding": {"type": "string", "minLength": 1},
        "why_matters": {"type": "string", "minLength": 1},
        "deadline": {"type": "string"}
      }
    },

    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "pros", "cons", "scores"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-D]$"
          },
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "pros": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "cons": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "implementation_complexity": {
            "type": "object",
            "properties": {
              "effort_estimate": {"type": "string"},
              "key_challenges": {"type": "array", "items": {"type": "string"}}
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "minProperties": 1
          },
          "weighted_total": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "description": "Auto-calculated weighted score"
          },
          "lock_in": {
            "type": "object",
            "properties": {
              "vendor_lock_in": {"$ref": "common.schema.json#/definitions/risk_level"},
              "reversibility": {"type": "boolean"},
              "exit_strategy": {"type": "string"}
            }
          }
        }
      }
    },

    "decision_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "weight"],
        "properties": {
          "name": {"type": "string"},
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {"type": "string"}
        }
      },
      "minItems": 1
    },

    "trade_off_matrix": {
      "type": "object",
      "description": "Generated from scores and criteria"
    },

    "risk_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_id", "risks"],
        "properties": {
          "option_id": {"type": "string", "pattern": "^[A-D]$"},
          "risks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description", "likelihood", "impact"],
              "properties": {
                "description": {"type": "string"},
                "likelihood": {"$ref": "common.schema.json#/definitions/risk_level"},
                "impact": {"$ref": "common.schema.json#/definitions/risk_level"},
                "mitigation": {"type": "string"},
                "owner": {"type": "string"}
              }
            }
          }
        }
      }
    },

    "recommendation": {
      "type": "string",
      "pattern": "^[A-D]$"
    },
    "confidence": {"$ref": "common.schema.json#/definitions/confidence"},
    "rationale": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "string",
      "description": "Under what conditions recommendation might change"
    }
  }
}
