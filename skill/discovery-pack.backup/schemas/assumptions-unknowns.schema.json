{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assumptions & Unknowns Schema",
  "type": "object",
  "required": ["project", "date", "assumptions"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "metadata": {"$ref": "common.schema.json#/definitions/metadata"},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption", "priority", "falsification_test", "impact_if_wrong"],
        "properties": {
          "id": {"type": "string"},
          "assumption": {"type": "string"},
          "tag": {"$ref": "common.schema.json#/definitions/tag"},
          "priority": {"$ref": "common.schema.json#/definitions/priority"},
          "evidence": {"type": "string"},
          "falsification_test": {"type": "string"},
          "impact_if_wrong": {"type": "string"},
          "validation_method": {"type": "string"},
          "owner": {"type": "string"},
          "deadline": {"type": "string", "format": "date"},
          "source_artifact": {"type": "string"},
          "source_line": {"type": "integer"}
        }
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unknown", "why_matters", "how_to_learn"],
        "properties": {
          "unknown": {"type": "string"},
          "why_matters": {"type": "string"},
          "how_to_learn": {"type": "string"},
          "owner": {"type": "string"},
          "deadline": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
